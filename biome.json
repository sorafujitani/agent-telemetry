{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**/*.js", "**/*.json", "**/*.css", "**/*.html"]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUndeclaredVariables": "error"
			}
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": { "enabled": true, "whitespaceSensitivity": "ignore" },
		"linter": { "enabled": true }
	}
}
